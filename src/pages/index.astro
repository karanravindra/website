---
import Base from "../layouts/Base.astro";

const roles = [
  {
    company: "Watts.ai",
    location: "Huntsville, AL",
    title: "Software Engineer",
    date: "December 2025 — Present",
    summary:
      "Building and hardening DoD-aligned AI software, with ownership across architecture, reliability, observability, and the long-term evolution of production systems.",
    details:
      "Works across agent design, model integration, execution environments, and system boundaries—helping turn ambitious prototypes into dependable services while mentoring and unblocking other engineers.",
  },
  {
    company: "SAIC",
    location: "Huntsville, AL",
    title: "Software Engineer",
    date: "May 2025 — December 2025",
    summary:
      "Developed AI-assisted tools for U.S. Army software teams, connecting LLMs with existing planning, Excel, and Azure DevOps workflows.",
    details:
      "Built full-stack applications with Next.js, Node, Express, and LangChain; shaped early agent systems and led interface redesigns for technical and non-technical users.",
  },
  {
    company: "SAIC",
    location: "Reston, VA",
    title: "Data Research Analyst",
    date: "May 2024 — August 2024",
    summary:
      "Turned a large resume corpus into a searchable talent intelligence system for leadership and proposal teams.",
    details:
      "Applied named entity recognition, embeddings, retrieval, and data mining to make expertise discoverable when the organization needed it.",
  },
  {
    company: "NetImpact Strategies",
    location: "Falls Church, VA",
    title: "Summer Intern",
    date: "2022 & 2023",
    summary:
      "Modernized internal workflows with Microsoft Power Platform and helped design teams adopt more reusable systems and better product practices.",
    details:
      "Built Power Apps and Power Automate flows, ran user testing, translated requirements for delivery teams, and introduced company-wide Figma training.",
  },
];
---

<Base>
  <section class="lead-story" aria-labelledby="lead-headline">
    <div class="lead-copy">
      <p class="eyebrow">Today’s lead story · Profile</p>
      <h1 id="lead-headline">Building useful software for complicated worlds.</h1>
      <p class="standfirst">
        Karan Ravindra is a student builder and software engineer working where
        applied AI, data-heavy products, and operational reality collide.
      </p>
      <div class="lead-byline">
        <span>By Karan Ravindra</span>
        <span>Purdue University · Class of 2026</span>
      </div>
    </div>

    <aside class="briefing" aria-label="At a glance">
      <p class="briefing-title">The Briefing</p>
      <dl>
        <div>
          <dt>Current desk</dt>
          <dd>Software Engineer<br />Watts.ai</dd>
        </div>
        <div>
          <dt>Coverage</dt>
          <dd>AI systems, data products, full-stack engineering</dd>
        </div>
        <div>
          <dt>Tools of record</dt>
          <dd>Python, TypeScript, SQL, PyTorch, LangChain</dd>
        </div>
      </dl>
      <a class="story-link" href="mailto:karan@karanravindra.com">Send a note</a>
    </aside>
  </section>

  <section class="news-grid" aria-label="Profile and featured project">
    <article class="about-story">
      <p class="section-label">The profile</p>
      <h2>He ships first. He overthinks it later.</h2>
      <div class="column-copy">
        <p>
          I make software that helps teams move faster. My focus is practical AI
          tooling, data-rich applications, and the unglamorous integration work
          that turns a promising system into one people can actually rely on.
        </p>
        <p>
          Most days are split between full-stack product engineering, experiments
          in language models and semantic search, and simplifying workflows that
          have accumulated too many moving parts.
        </p>
        <p>
          I care about clear interfaces, sturdy architecture, and the last 20%
          of work that separates a demonstration from a useful product.
        </p>
      </div>
    </article>

    <article class="featured-project">
      <div class="project-stamp" aria-hidden="true">01</div>
      <p class="section-label">Interactive edition</p>
      <p class="dateline">Machine Learning Desk</p>
      <h2>Can a tiny neural network read your handwriting?</h2>
      <p>
        Draw a number and watch a PyTorch-trained classifier make its case in
        real time. Ten digits enter; one prediction leaves.
      </p>
      <div class="project-facts">
        <span>PyTorch</span>
        <span>ONNX</span>
        <span>Live inference</span>
      </div>
      <a class="story-link" href="/projects/mnist">Try the experiment</a>
    </article>
  </section>

  <section class="experience" aria-labelledby="experience-heading">
    <p class="section-label">The record</p>
    <header class="section-heading">
      <div>
        <p class="eyebrow">Experience · 2022—Present</p>
        <h2 id="experience-heading">From data retrieval to production AI.</h2>
      </div>
      <p>
        A running account of systems built, teams supported, and difficult
        technical problems made a little more tractable.
      </p>
    </header>

    <div class="role-list">
      {roles.map((role, index) => (
        <article class="role">
          <p class="role-index">{String(index + 1).padStart(2, "0")}</p>
          <div class="role-title">
            <p class="role-date">{role.date}</p>
            <h3>{role.company}</h3>
            <p>{role.title} · {role.location}</p>
          </div>
          <p class="role-summary">{role.summary}</p>
          <p class="role-details">{role.details}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="education-toolkit" aria-label="Education and toolkit">
    <article>
      <p class="section-label">Education</p>
      <p class="eyebrow">West Lafayette, Indiana</p>
      <h2>Purdue University</h2>
      <p class="degree">B.S. in Data Analytics, Technologies &amp; Applications</p>
      <p>
        Coursework spans applied machine learning, enterprise data management,
        databases, systems analysis, statistics, public policy, and responsible AI.
      </p>
      <p class="fine-print">Expected May 2026 · Polytechnic Institute</p>
    </article>

    <article>
      <p class="section-label">Working set</p>
      <h2>A practical toolkit for messy systems.</h2>
      <ul class="tool-list" aria-label="Technical toolkit">
        <li>Python</li>
        <li>TypeScript</li>
        <li>SQL</li>
        <li>PyTorch</li>
        <li>Hugging Face</li>
        <li>Node.js</li>
        <li>Git &amp; GitHub</li>
        <li>Power Platform</li>
      </ul>
      <p class="fine-print">
        PCEP Python · PL-900 · Figma · UX Design
      </p>
    </article>
  </section>
</Base>

<style>
  .lead-story {
    display: grid;
    grid-template-columns: minmax(0, 3.1fr) minmax(17rem, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-bottom: clamp(2rem, 5vw, 4rem);
    border-bottom: 4px double var(--rule);
  }

  .lead-copy h1 {
    max-width: 1000px;
    margin: 0.22em 0 0.32em;
    font-size: clamp(3.7rem, 5.2vw, 5.35rem);
    font-weight: 900;
    letter-spacing: -0.067em;
    line-height: 0.83;
  }

  .standfirst {
    max-width: 820px;
    margin-bottom: 1.5rem;
    color: #3d3a33;
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    line-height: 1.35;
  }

  .lead-byline {
    display: flex;
    gap: 1rem;
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .lead-byline span + span {
    padding-left: 1rem;
    color: var(--ink-soft);
    border-left: 1px solid var(--rule);
  }

  .briefing {
    padding: 1rem 0 0;
    border-top: 8px solid var(--accent);
  }

  .briefing-title {
    margin-bottom: 0.4rem;
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .briefing dl {
    margin: 0 0 1rem;
  }

  .briefing dl > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-top: 1px solid #a8a091;
  }

  .briefing dt {
    font: 900 0.62rem/1.35 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .briefing dd {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--rule);
  }

  .about-story h2,
  .featured-project h2,
  .section-heading h2,
  .education-toolkit h2 {
    margin-bottom: 0.5em;
    font-size: clamp(2rem, 3.2vw, 3rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .column-copy {
    columns: 2;
    column-gap: 2.25rem;
    column-rule: 1px solid #aaa292;
  }

  .column-copy p {
    margin-bottom: 1rem;
  }

  .column-copy p:first-child::first-letter {
    float: left;
    margin: 0.07em 0.1em 0 0;
    color: var(--accent);
    font-size: 4.8em;
    font-weight: 900;
    line-height: 0.72;
  }

  .featured-project {
    position: relative;
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    border-left: 1px solid var(--rule);
  }

  .project-stamp {
    position: absolute;
    top: -1rem;
    right: 0;
    color: rgb(159 43 32 / 12%);
    font-family: var(--sans);
    font-size: 9rem;
    font-weight: 900;
    line-height: 1;
  }

  .featured-project > *:not(.project-stamp) {
    position: relative;
  }

  .project-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1.5rem 0;
  }

  .project-facts span,
  .tool-list li {
    padding: 0.36rem 0.55rem;
    color: var(--paper);
    background: var(--ink);
    font: 800 0.6rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience {
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-heading > p {
    padding-left: 1.5rem;
    border-left: 4px solid var(--accent);
  }

  .role-list {
    border-top: 4px solid var(--rule);
  }

  .role {
    display: grid;
    grid-template-columns: 3rem minmax(12rem, 0.75fr) minmax(14rem, 1fr) minmax(14rem, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .role-index {
    color: var(--accent);
    font: 900 0.78rem/1 var(--sans);
  }

  .role h3 {
    margin: 0.2rem 0 0;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .role-title > p:last-child,
  .role-details {
    color: var(--ink-soft);
  }

  .role-title > p:last-child,
  .role-summary,
  .role-details {
    margin-bottom: 0;
    font-size: 0.92rem;
    line-height: 1.52;
  }

  .education-toolkit {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .education-toolkit article + article {
    padding-left: clamp(1.5rem, 4vw, 4rem);
    border-left: 1px solid var(--rule);
  }

  .degree {
    font-size: 1.15rem;
    font-style: italic;
  }

  .fine-print {
    color: var(--ink-soft);
    font: 800 0.66rem/1.4 var(--sans);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 860px) {
    .lead-story,
    .news-grid,
    .section-heading,
    .education-toolkit {
      grid-template-columns: 1fr;
    }

    .briefing {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 0 2rem;
      align-items: start;
    }

    .briefing .story-link {
      grid-column: 2;
    }

    .featured-project,
    .education-toolkit article + article {
      padding: 2rem 0 0;
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .role {
      grid-template-columns: 2rem minmax(12rem, 0.8fr) minmax(14rem, 1.2fr);
    }

    .role-details {
      grid-column: 2 / -1;
    }
  }

  @media (orientation: landscape) and (min-width: 861px) {
    .lead-story {
      grid-template-columns: minmax(0, 2.25fr) minmax(16rem, 0.75fr);
    }

    .lead-copy h1 {
      max-width: 880px;
    }

    .briefing {
      margin-top: 0.1rem;
    }

    .news-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(19rem, 0.6fr);
    }
  }

  @media (orientation: portrait) {
    .lead-story,
    .news-grid,
    .section-heading,
    .education-toolkit {
      grid-template-columns: 1fr;
    }

    .lead-copy h1 {
      max-width: 13ch;
      font-size: clamp(3.35rem, 10vw, 5.25rem);
    }

    .briefing {
      display: grid;
      grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.35fr);
      gap: 0 2rem;
    }

    .briefing .story-link {
      grid-column: 2;
    }

    .featured-project,
    .education-toolkit article + article {
      padding: 2rem 0 0;
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .section-heading {
      gap: 1rem;
    }
  }

  @media (max-width: 600px) {
    .lead-copy h1 {
      font-size: clamp(3.45rem, 17vw, 5.2rem);
    }

    .lead-byline {
      display: grid;
    }

    .lead-byline span + span {
      padding-left: 0;
      border: 0;
    }

    .briefing {
      display: block;
    }

    .briefing .story-link {
      grid-column: auto;
    }

    .column-copy {
      columns: 1;
    }

    .section-heading {
      gap: 0.75rem;
    }

    .section-heading > p {
      padding-left: 1rem;
    }

    .role {
      grid-template-columns: 1.8rem 1fr;
      gap: 0.75rem;
    }

    .role-summary,
    .role-details {
      grid-column: 2;
    }
  }

  @media (orientation: landscape) and (max-height: 720px) and (min-width: 861px) {
    .lead-story {
      gap: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .lead-copy h1 {
      max-width: 900px;
      font-size: clamp(3.25rem, 4.8vw, 4.75rem);
    }

    .standfirst {
      font-size: 1.15rem;
    }
  }
</style>
