---
import Base from "../../layouts/Base.astro";
---

<Base
  title="MNIST Digit Recognizer — Karan Ravindra"
  description="Draw a number and watch a neural network classify it live in your browser."
>
  <header class="experiment-header">
    <div>
      <p class="eyebrow">Live desk · Machine learning</p>
      <h1>A machine reads your handwriting.</h1>
    </div>
    <div class="experiment-deck">
      <p class="deck-label">In brief</p>
      <p>
        Draw a digit from zero to nine. The model publishes a prediction—and
        every confidence score—as you write.
      </p>
      <dl class="experiment-facts">
        <div>
          <dt>Training</dt>
          <dd>PyTorch · QMNIST</dd>
        </div>
        <div>
          <dt>Runtime</dt>
          <dd>ONNX · In browser</dd>
        </div>
        <div>
          <dt>Input</dt>
          <dd>32 × 32 pixels</dd>
        </div>
        <div>
          <dt>Output</dt>
          <dd>10 confidence scores</dd>
        </div>
      </dl>
    </div>
  </header>

  <section class="experiment" aria-labelledby="experiment-title">
    <div class="experiment-bar">
      <h2 id="experiment-title">The live test</h2>
      <p><span class="status-dot"></span> Model runs locally in this browser</p>
    </div>

    <div x-data="mnistApp()" x-init="init()" class="workspace">
      <div class="drawing-panel">
        <div class="panel-heading">
          <p><span>01</span> Write a digit</p>
          <p>Black ink · one stroke or many</p>
        </div>
        <canvas
          x-ref="canvas"
          width="32"
          height="32"
          aria-label="Drawing canvas for a handwritten digit"
          @mousedown="beginDraw($event)"
          @mousemove="draw($event)"
          @mouseup="endDraw()"
          @mouseleave="endDraw()"
          @touchstart.prevent="beginDraw($event)"
          @touchmove.prevent="draw($event)"
          @touchend.prevent="endDraw()"></canvas>
        <div class="controls">
          <button type="button" @click="clearCanvas()">Clear the canvas</button>
          <button type="button" @click="saveDrawing()" :disabled="saving">
            <span x-text="saving ? 'Saving…' : 'Save drawing'"></span>
          </button>
          <span
            id="status"
            role="status"
            aria-live="polite"
            x-text="status"
            :class="{ error: status.startsWith('Error:') }"></span>
        </div>
        <p class="save-msg" x-show="saveMsg" x-text="saveMsg" role="status" aria-live="polite"></p>
        <p class="privacy-note">
          Saving stores your drawing anonymously—along with coarse
          device and browser info—to help build a public handwriting dataset.
          No account or personal identity is collected.
        </p>
      </div>

      <div class="results-panel">
        <div class="panel-heading">
          <p><span>02</span> Read the probabilities</p>
          <p>Confidence by digit</p>
        </div>
        <div id="chart" aria-label="Prediction confidence chart">
          <template x-for="bar in bars" :key="bar.digit">
            <div class="bar-row" :class="bar.rankClass">
              <div class="bar-label" x-text="bar.digit"></div>
              <div class="bar-track">
                <div class="bar-fill" :style="`width: ${bar.width}`"></div>
              </div>
              <div class="bar-pct" x-text="bar.pctText"></div>
            </div>
          </template>
        </div>
      </div>
    </div>
  </section>

  <section class="field-notes" aria-label="How the experiment works">
    <p class="section-label">Field notes</p>
    <div class="notes-grid">
      <article>
        <p class="note-number">01 / Input</p>
        <h2>Your drawing becomes data.</h2>
        <p>
          The canvas records a 32-by-32 grayscale image. Pixel values are
          normalized to match the examples the model saw during training.
        </p>
      </article>
      <article>
        <p class="note-number">02 / Inference</p>
        <h2>The browser does the work.</h2>
        <p>
          An ONNX version of the trained network runs locally with WebAssembly.
          Your drawing is not uploaded to an application server.
        </p>
      </article>
      <article>
        <p class="note-number">03 / Result</p>
        <h2>Uncertainty stays visible.</h2>
        <p>
          Instead of revealing only the winning digit, the chart shows the
          entire distribution—because confidence is part of the answer.
        </p>
      </article>
    </div>
  </section>

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.20.1/dist/ort.min.js"
    ></script>
    <script is:inline>
      const HF_REPO_ID = "karanravindra/mnist-cnn-onnx";
      const HF_MODEL_FILE = "mnist_cnn.onnx";
      const MODEL_PATH = `https://huggingface.co/${HF_REPO_ID}/resolve/main/${HF_MODEL_FILE}?download=1`;

      function mnistApp() {
        return {
          ctx: null,
          status: "",
          isDrawing: false,
          lastX: 0,
          lastY: 0,
          idleTimer: null,
          sessionPromise: null,
          inferring: false,
          pendingInfer: false,
          anonId: "",
          saving: false,
          saveMsg: "",
          lastTop: null,
          lastConf: null,
          bars: Array.from({ length: 10 }, (_, digit) => ({
            digit,
            width: "0%",
            pctText: "—",
            rankClass: "rest",
          })),

          init() {
            this.ctx = this.$refs.canvas.getContext("2d");
            this.clearBg();
            this.anonId = this.getAnonId();
            this.getSession().catch(() => {});
          },

          // Anonymous, client-generated id persisted in localStorage.
          // Not tied to any real identity — just lets us group submissions.
          getAnonId() {
            try {
              let id = localStorage.getItem("anonId");
              if (!id) {
                id = crypto.randomUUID();
                localStorage.setItem("anonId", id);
              }
              return id;
            } catch {
              return "unknown";
            }
          },

          // Canvas is always black-background / white-digit to match model expectations.
          // The visual canvas is then CSS-inverted in light mode so it looks natural to the user.
          clearBg() {
            this.ctx.fillStyle = "#000";
            this.ctx.fillRect(0, 0, 32, 32);
          },

          getPos(e) {
            const rect = this.$refs.canvas.getBoundingClientRect();
            const src = e.touches?.length
              ? e.touches[0]
              : e.changedTouches?.length
                ? e.changedTouches[0]
                : e;
            return {
              x: (src.clientX - rect.left) * (32 / rect.width),
              y: (src.clientY - rect.top) * (32 / rect.height),
            };
          },

          beginDraw(e) {
            this.isDrawing = true;
            const { x, y } = this.getPos(e);
            this.lastX = x;
            this.lastY = y;
            this.resetIdleTimer();
          },

          draw(e) {
            if (!this.isDrawing) return;
            const { x, y } = this.getPos(e);
            this.ctx.strokeStyle = "#fff"; // always draw white digit on black canvas
            this.ctx.lineWidth = 2;
            this.ctx.lineCap = "round";
            this.ctx.lineJoin = "round";
            this.ctx.beginPath();
            this.ctx.moveTo(this.lastX, this.lastY);
            this.ctx.lineTo(x, y);
            this.ctx.stroke();
            this.lastX = x;
            this.lastY = y;
            this.resetIdleTimer();
          },

          endDraw() {
            this.isDrawing = false;
          },

          resetIdleTimer() {
            clearTimeout(this.idleTimer);
            this.idleTimer = setTimeout(() => this.triggerInfer(), 100);
          },

          clearCanvas() {
            this.clearBg();
            clearTimeout(this.idleTimer);
            this.status = "";
            this.saveMsg = "";
            this.lastTop = null;
            this.lastConf = null;
            this.bars = this.bars.map((bar) => ({
              ...bar,
              width: "0%",
              pctText: "—",
              rankClass: "rest",
            }));
          },

          async getSession() {
            if (!this.sessionPromise) {
              ort.env.wasm.wasmPaths =
                "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.20.1/dist/";
              this.sessionPromise = ort.InferenceSession.create(MODEL_PATH, {
                executionProviders: ["wasm"],
              });
              this.status = "loading model…";
              this.sessionPromise
                .then(() => {
                  if (this.status === "loading model…") this.status = "";
                })
                .catch(() => {});
            }
            return this.sessionPromise;
          },

          getInputTensor() {
            const imageData = this.ctx.getImageData(0, 0, 32, 32);
            const data = imageData.data;
            const raw = new Float32Array(32 * 32);
            const input = new Float32Array(32 * 32);
            for (let i = 0; i < 32 * 32; i++) {
              // Canvas is always black-bg/white-digit: red channel directly gives [0,1]
              raw[i] = data[i * 4] / 255.0;
              input[i] = (raw[i] - 0.1307) / 0.3081;
            }
            const nonzero = raw.filter((v) => v > 0).length;
            const rawMin = Math.min(...raw).toFixed(4);
            const rawMax = Math.max(...raw).toFixed(4);
            const normMin = Math.min(...input).toFixed(4);
            const normMax = Math.max(...input).toFixed(4);
            console.log("[mnist] raw pixels — min:", rawMin, "max:", rawMax, "nonzero:", nonzero, "/", 32 * 32);
            console.log("[mnist] normalized — min:", normMin, "max:", normMax);
            return new ort.Tensor("float32", input, [1, 1, 32, 32]);
          },

          softmaxByDigit(logits) {
            let maxLogit = -Infinity;
            for (let i = 0; i < logits.length; i++) {
              if (logits[i] > maxLogit) maxLogit = logits[i];
            }
            let sumExp = 0;
            const exps = new Float32Array(logits.length);
            for (let i = 0; i < logits.length; i++) {
              exps[i] = Math.exp(logits[i] - maxLogit);
              sumExp += exps[i];
            }
            return Array.from(exps, (v) => v / sumExp);
          },

          updateChart(probs) {
            const sorted = probs
              .map((p, i) => ({ p, i }))
              .sort((a, b) => b.p - a.p);
            const rank = new Array(10);
            sorted.forEach(({ i }, r) => {
              rank[i] = r;
            });

            this.bars = this.bars.map((bar, d) => {
              const pctVal = probs[d] * 100;
              const r = rank[d];
              return {
                ...bar,
                width: `${pctVal.toFixed(1)}%`,
                pctText: `${pctVal.toFixed(1)}%`,
                rankClass:
                  r === 0
                    ? "top1"
                    : r === 1
                      ? "top2"
                      : r === 2
                        ? "top3"
                        : "rest",
              };
            });

            this.lastTop = sorted[0].i;
            this.lastConf = sorted[0].p;
            this.status = `${sorted[0].i} · ${(sorted[0].p * 100).toFixed(1)}%`;
          },

          // True when the canvas has any ink drawn on it.
          hasInk() {
            const { data } = this.ctx.getImageData(0, 0, 32, 32);
            for (let i = 0; i < data.length; i += 4) {
              if (data[i] > 0) return true; // red channel = ink on black bg
            }
            return false;
          },

          async saveDrawing() {
            if (this.saving) return;
            if (!this.hasInk()) {
              this.saveMsg = "Draw a digit first.";
              return;
            }
            this.saving = true;
            this.saveMsg = "";
            try {
              const pixels = this.$refs.canvas.toDataURL("image/png");
              const res = await fetch("/api/log", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  source: "mnist",
                  pixels,
                  predicted: this.lastTop,
                  confidence: this.lastConf,
                  width: 32,
                  height: 32,
                  anonId: this.anonId,
                }),
              });
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              this.saveMsg = "Saved. Thank you!";
            } catch (err) {
              this.saveMsg = `Could not save: ${err.message}`;
              console.error(err);
            } finally {
              this.saving = false;
            }
          },

          async triggerInfer() {
            if (this.inferring) {
              this.pendingInfer = true;
              return;
            }
            this.inferring = true;
            try {
              const session = await this.getSession();
              if (this.status === "loading model…") this.status = "";
              const results = await session.run({
                input: this.getInputTensor(),
              });
              this.updateChart(this.softmaxByDigit(results.logits.data));
            } catch (err) {
              this.status = `<span class="error">Error: ${err.message}</span>`;
              console.error(err);
            } finally {
              this.inferring = false;
              if (this.pendingInfer) {
                this.pendingInfer = false;
                this.triggerInfer();
              }
            }
          },
        };
      }
    </script>
</Base>

<style>
  .experiment-header {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
    border-bottom: 4px double var(--rule);
  }

  .experiment-header h1 {
    max-width: 840px;
    margin: 0.18em 0 0;
    font-size: clamp(3.6rem, 4.4vw, 4.75rem);
    font-weight: 900;
    letter-spacing: -0.07em;
    line-height: 0.82;
  }

  .experiment-deck {
    padding-top: 0.85rem;
    border-top: 6px solid var(--accent);
  }

  .experiment-deck > p:not(.deck-label) {
    max-width: 34rem;
    margin-bottom: 1.25rem;
    font-size: clamp(1rem, 1.25vw, 1.14rem);
    font-style: italic;
    line-height: 1.42;
  }

  .deck-label,
  .panel-heading,
  .note-number {
    font-family: var(--sans);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .deck-label {
    margin-bottom: 0.65rem;
    color: var(--accent);
  }

  .experiment-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .experiment-facts div {
    padding: 0.65rem 0;
    border-bottom: 1px solid #aaa292;
  }

  .experiment-facts div:nth-child(odd) {
    padding-right: 0.8rem;
    border-right: 1px solid #aaa292;
  }

  .experiment-facts div:nth-child(even) {
    padding-left: 0.8rem;
  }

  .experiment-facts dt {
    color: var(--ink-soft);
    font: 900 0.56rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .experiment-facts dd {
    margin: 0.25rem 0 0;
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .experiment {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    border-top: 8px solid var(--accent);
    border-bottom: 1px solid var(--rule);
  }

  .experiment-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .experiment-bar h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .experiment-bar p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font: 900 0.62rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgb(159 43 32 / 12%);
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(320px, 1.2fr);
  }

  .drawing-panel,
  .results-panel {
    min-width: 0;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .drawing-panel {
    border-right: 1px solid var(--rule);
  }

  .panel-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--ink-soft);
  }

  .panel-heading p {
    margin: 0;
  }

  .panel-heading p:first-child {
    color: var(--ink);
  }

  .panel-heading span {
    color: var(--accent);
  }

  canvas {
    display: block;
    width: min(100%, 430px);
    aspect-ratio: 1;
    height: auto;
    border: 1px solid var(--rule);
    cursor: crosshair;
    filter: invert(93%) sepia(8%) saturate(435%) hue-rotate(356deg) brightness(103%);
    image-rendering: pixelated;
    touch-action: none;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
    min-height: 2.25rem;
    margin-top: 0.8rem;
  }

  button {
    padding: 0.68rem 0.9rem;
    color: var(--paper);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 0;
    cursor: pointer;
    font: 900 0.64rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 140ms ease, background 140ms ease;
  }

  button:hover {
    color: var(--ink);
    background: transparent;
  }

  button:disabled {
    cursor: default;
    opacity: 0.5;
  }

  button:disabled:hover {
    color: var(--paper);
    background: var(--ink);
  }

  .save-msg {
    margin: 0.6rem 0 0;
    color: var(--accent);
    font: 700 0.72rem/1.3 var(--sans);
    letter-spacing: 0.02em;
  }

  .privacy-note {
    max-width: 28rem;
    margin: 0.6rem 0 0;
    color: var(--muted, #6b6b6b);
    font: 400 0.7rem/1.45 var(--sans);
  }

  #status {
    color: var(--accent);
    font: 900 0.68rem/1 var(--mono);
    letter-spacing: 0.03em;
  }

  #chart {
    display: grid;
    gap: 0.52rem;
    min-width: 0;
    padding-top: 0.2rem;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr) 3.6rem;
    gap: 0.75rem;
    align-items: center;
    font-family: var(--sans);
    font-size: 0.78rem;
  }

  .bar-label {
    text-align: right;
    font-size: 1rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .bar-track {
    height: 1.55rem;
    overflow: hidden;
    background: #ded7c8;
    border-left: 1px solid var(--rule);
  }

  .bar-fill {
    width: 0%;
    height: 100%;
    background: #969082;
    transition: width 120ms ease, background 120ms ease, opacity 120ms ease;
  }

  .bar-pct {
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .bar-row.top1 .bar-fill {
    background: var(--accent);
  }

  .bar-row.top2 .bar-fill {
    background: var(--ink);
    opacity: 0.65;
  }

  .bar-row.top3 .bar-fill {
    background: var(--ink);
    opacity: 0.38;
  }

  .bar-row.rest .bar-fill {
    opacity: 0.42;
  }

  .bar-row.top1 .bar-label,
  .bar-row.top1 .bar-pct {
    color: var(--accent);
  }

  .bar-row.top1 .bar-label {
    transform: scale(1.15);
  }

  .error {
    color: var(--accent-dark) !important;
  }

  .field-notes {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 4px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .notes-grid article {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-right: 1px solid var(--rule);
  }

  .notes-grid article:last-child {
    border-right: 0;
  }

  .note-number {
    color: var(--accent);
  }

  .notes-grid h2 {
    margin-bottom: 0.6rem;
    font-size: clamp(1.45rem, 2.5vw, 2.15rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .notes-grid article > p:last-child {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .experiment-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .experiment-header h1 {
      font-size: clamp(3.7rem, 16vw, 6.5rem);
    }

    .workspace {
      grid-template-columns: 1fr;
    }

    .drawing-panel {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    canvas {
      width: min(100%, 520px);
      margin-inline: auto;
    }

    .notes-grid {
      grid-template-columns: 1fr;
    }

    .notes-grid article,
    .notes-grid article:last-child {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .notes-grid article:last-child {
      border-bottom: 0;
    }
  }

  @media (orientation: portrait) {
    .experiment-header,
    .workspace {
      grid-template-columns: 1fr;
    }

    .experiment-header {
      gap: 1.5rem;
    }

    .experiment-header h1 {
      max-width: 11ch;
      font-size: clamp(3.3rem, 9vw, 4.8rem);
    }

    .drawing-panel {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    canvas {
      width: min(100%, 520px);
      margin-inline: auto;
    }
  }

  @media (orientation: landscape) and (max-height: 720px) and (min-width: 821px) {
    .experiment-header {
      gap: 3rem;
      padding-bottom: 2.75rem;
    }

    .experiment-header h1 {
      font-size: clamp(3.2rem, 4.2vw, 4.5rem);
    }

    .experiment {
      margin-top: 2.75rem;
    }
  }

  @media (max-width: 520px) {
    .experiment-bar,
    .panel-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .bar-row {
      grid-template-columns: 1.2rem minmax(0, 1fr) 3.3rem;
      gap: 0.5rem;
    }
  }
</style>
