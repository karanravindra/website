---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Karan Ravindra — Software Engineer",
  description = "The independent portfolio of Karan Ravindra: software, applied AI, data systems, and experiments.",
} = Astro.props;

const pathname = Astro.url.pathname;
const editionDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(new Date());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe4" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to the stories</a>
    <div class="page-shell">
      <header class="site-header">
        <div class="edition-bar" aria-label="Publication information">
          <span>Vol. I · No. 01</span>
          <span class="edition-date">{editionDate}</span>
          <span>Independent Portfolio</span>
        </div>

        <a class="masthead" href="/" aria-label="Karan Ravindra, home">
          <span class="masthead-kicker">The</span>
          <span class="masthead-name">Karan Ravindra</span>
          <span class="masthead-kicker">Review</span>
        </a>

        <div class="strapline">
          <span>Software</span>
          <span>Applied AI</span>
          <span>Data Systems</span>
          <span>Useful Experiments</span>
        </div>

        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/" aria-current={pathname === "/" ? "page" : undefined}>Front Page</a>
          <a href="/projects" aria-current={pathname.startsWith("/projects") ? "page" : undefined}>Projects</a>
          <a href="mailto:karan@karanravindra.com">Correspondence</a>
          <a href="https://github.com/karanravindra" rel="me">GitHub</a>
          <a href="https://linkedin.com/in/karanravindra" rel="me">LinkedIn</a>
        </nav>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <p class="footer-mark">K·R</p>
        <p>Reporting from the intersection of software, data, and applied intelligence.</p>
        <div class="footer-meta">
          <span>Set in type &amp; shipped on the web</span>
          <a href="mailto:karan@karanravindra.com">karan@karanravindra.com</a>
          <span>© {new Date().getFullYear()} Karan Ravindra</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f3efe4;
    --paper-deep: #e8e0cf;
    --ink: #171713;
    --ink-soft: #5e5a50;
    --rule: #24231f;
    --accent: #9f2b20;
    --accent-dark: #701d16;
    --serif: Georgia, "Times New Roman", Times, serif;
    --sans: "Arial Narrow", "Roboto Condensed", "Helvetica Neue", Arial, sans-serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --page-width: 1240px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--paper-deep);
  }

  body {
    margin: 0;
    color: var(--ink);
    background:
      radial-gradient(circle at 18% 12%, rgb(255 255 255 / 36%), transparent 28rem),
      var(--paper-deep);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.58;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    color: var(--paper);
    background: var(--accent);
  }

  a {
    color: inherit;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--accent);
  }

  a:focus-visible,
  button:focus-visible,
  canvas:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 1rem;
    left: 1rem;
    padding: 0.6rem 0.9rem;
    color: var(--paper);
    background: var(--ink);
    font: 700 0.75rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    color: var(--paper);
    transform: translateY(0);
  }

  .page-shell {
    width: min(calc(100% - 2rem), var(--page-width));
    min-height: 100vh;
    margin: 1rem auto;
    padding: clamp(1rem, 3vw, 2.5rem);
    overflow: hidden;
    background:
      linear-gradient(rgb(23 23 19 / 2%) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 4px;
    box-shadow: 0 12px 44px rgb(38 31 20 / 18%);
  }

  .site-header {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .edition-bar,
  .strapline,
  .primary-nav,
  .footer-meta {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .edition-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 4px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .edition-bar > :last-child {
    text-align: right;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    padding: clamp(1.25rem, 3vw, 2rem) 0 1rem;
    color: var(--ink);
    text-align: center;
    text-decoration: none;
  }

  .masthead:hover {
    color: var(--ink);
  }

  .masthead-name {
    font-size: clamp(2.9rem, 5.1vw, 5.25rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .masthead-kicker {
    font-family: var(--sans);
    font-size: clamp(0.52rem, 1.2vw, 0.72rem);
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .strapline {
    display: flex;
    justify-content: center;
    gap: 0;
    padding: 0.65rem 0;
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
  }

  .strapline span {
    padding: 0 1.25rem;
    border-right: 1px solid #a39b8b;
  }

  .strapline span:last-child {
    border: 0;
  }

  .primary-nav {
    display: flex;
    justify-content: center;
    border-top: 1px solid var(--rule);
    border-bottom: 4px double var(--rule);
  }

  .primary-nav a {
    padding: 0.78rem clamp(0.7rem, 2vw, 1.4rem);
    text-decoration: none;
    border-right: 1px solid #b7ae9c;
    transition: color 140ms ease, background 140ms ease;
  }

  .primary-nav a:first-child {
    border-left: 1px solid #b7ae9c;
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current="page"] {
    color: var(--paper);
    background: var(--ink);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  .eyebrow,
  .section-label,
  .dateline,
  .story-meta,
  .project-number,
  .fact-label,
  .role-date {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .eyebrow,
  .section-label,
  .dateline,
  .project-number {
    color: var(--accent);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    white-space: nowrap;
  }

  .section-label::after {
    width: 100%;
    height: 1px;
    background: var(--rule);
    content: "";
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .story-link::after {
    content: "→";
    transition: transform 140ms ease;
  }

  .story-link:hover::after {
    transform: translateX(0.25rem);
  }

  .site-footer {
    display: grid;
    grid-template-columns: auto minmax(12rem, 1fr) 1.4fr;
    gap: 1.5rem;
    align-items: center;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding: 1.5rem 0 0;
    border-top: 4px double var(--rule);
  }

  .site-footer p {
    margin: 0;
  }

  .footer-mark {
    display: grid;
    width: 3.4rem;
    aspect-ratio: 1;
    place-items: center;
    color: var(--paper);
    background: var(--accent);
    font-size: 1rem;
    font-weight: 900;
    line-height: 1;
  }

  .footer-meta {
    display: grid;
    gap: 0.4rem;
    justify-items: end;
    color: var(--ink-soft);
    text-align: right;
  }

  @media (max-width: 720px) {
    body {
      font-size: 16px;
    }

    .page-shell {
      width: 100%;
      margin: 0;
      padding: 1rem;
      box-shadow: none;
    }

    .site-header {
      margin-bottom: 2.75rem;
    }

    .edition-bar {
      grid-template-columns: 1fr 1fr;
      font-size: 0.58rem;
    }

    .edition-date {
      display: none;
    }

    .masthead {
      display: block;
      padding: 1.4rem 0 1rem;
    }

    .masthead-kicker {
      display: none;
    }

    .masthead-name {
      font-size: clamp(2.8rem, 15vw, 4.5rem);
      line-height: 0.88;
    }

    .strapline {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.35rem 0;
      font-size: 0.58rem;
      text-align: center;
    }

    .strapline span {
      padding: 0.15rem 0.35rem;
    }

    .strapline span:nth-child(2) {
      border: 0;
    }

    .primary-nav {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .primary-nav a {
      padding: 0.7rem 0.4rem;
      font-size: 0.58rem;
      text-align: center;
      border-bottom: 1px solid #b7ae9c;
    }

    .primary-nav a:first-child {
      border-left: 0;
    }

    .primary-nav a:nth-child(3) {
      border-right: 0;
    }

    .primary-nav a:nth-child(n + 4) {
      grid-column: span 1;
      border-bottom: 0;
    }

    .primary-nav a:nth-child(4) {
      grid-column: 1 / 2;
    }

    .primary-nav a:nth-child(5) {
      grid-column: 2 / 4;
    }

    .site-footer {
      grid-template-columns: auto 1fr;
    }

    .footer-meta {
      grid-column: 1 / -1;
      justify-items: start;
      text-align: left;
    }
  }

  /* Portrait reads like a narrow, single-column edition—even on tablets. */
  @media (orientation: portrait) {
    .page-shell {
      width: min(calc(100% - 1rem), 880px);
      margin-block: 0.5rem;
    }

    .masthead {
      padding-block: 1.35rem 1rem;
    }

    .masthead-name {
      font-size: clamp(3rem, 11vw, 4.8rem);
    }

    .site-header {
      margin-bottom: clamp(2.5rem, 6vh, 4rem);
    }
  }

  /* Landscape keeps the broadsheet wide but avoids spending the viewport on chrome. */
  @media (orientation: landscape) and (max-height: 820px) {
    .page-shell {
      margin-block: 0.5rem;
      padding-top: 1rem;
    }

    .site-header {
      margin-bottom: 2.5rem;
    }

    .masthead {
      padding-block: 1rem 0.75rem;
    }

    .masthead-name {
      font-size: clamp(3.25rem, 5.4vw, 4.9rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
